# Server-side only. Never expose to the browser.
OPENAI_API_KEY=
# Model used for realtime voice sessions
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin
PORT=8787
# Optional: transcribes handwriting (else it's sent to the voice model as an image)
ANTHROPIC_API_KEY=
RECOGNIZE_MODEL=claude-haiku-5-5
# Optional: transcribes the student's speech for the chat panel
REALTIME_TRANSCRIBE_MODEL=gpt-realtime-whisper
